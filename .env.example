# Copy to .env and replace every value. .env is gitignored; never commit it.

# Control-plane database owner (runs migrations only).
CONTROL_DB_OWNER_PASSWORD=change-me
# Password of the unprivileged role the API logs in as.
CONTROL_DB_API_PASSWORD=change-me-too
# Signing key for access tokens, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Data plane (the managed PostgreSQL cluster).
DATAPLANE_OWNER_PASSWORD=change-me
DATAPLANE_REPLICATION_PASSWORD=change-me
DATAPLANE_PGBOUNCER_AUTH_PASSWORD=change-me
# Development seed only: one password shared by the four demo tenant roles.
DATAPLANE_TENANT_PASSWORD=change-me
# 1.0 = TPC-C population (3,000 customers per district); smaller loads faster.
SEED_SCALE=1.0
SEED_ITEMS=100000

# Telemetry collector: its role on the control-plane database and on the data plane.
CONTROL_DB_COLLECTOR_PASSWORD=change-me
DATAPLANE_MONITOR_PASSWORD=change-me
COLLECT_INTERVAL_S=60

# Demo organization created by `docker compose run --rm demo-seed`.
DEMO_ADMIN_EMAIL=admin@demo.dbpilot.dev
DEMO_ADMIN_PASSWORD=change-me-min-10-chars

# Experimentation plane.
TWIN_TOKEN=change-me
# How far the twin source trails production. Also the longest replay window.
TWIN_DELAY_S=180

# Verification engine.
CONTROL_DB_ENGINE_PASSWORD=change-me
# Length of workload replayed on the twin; at most TWIN_DELAY_S.
TWIN_WINDOW_S=120
TWIN_REPETITIONS=2

# LLM agent (optional). Leave empty to use only the rule-based proposer.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
