# Fixed, non-secret settings of benchmark mode. Read after .env, so these win.
# Secrets stay in .env, which is never committed.

# Dataset: the 0.3-scale population every earlier measurement used (about 380 MB).
SEED_SCALE=0.3
SEED_ITEMS=30000

# PostgreSQL and container sizes.
DP_SHARED_BUFFERS=512MB
STANDBY_SHARED_BUFFERS=128MB
DP_MEM_LIMIT=1536m
REPLICA_MEM_LIMIT=768m
# Two clones are up at once in the simultaneous and interleaved procedures.
TWIN_MEM_LIMIT=2560m

# Telemetry and twin timing.
COLLECT_INTERVAL_S=20
TWIN_DELAY_S=60
TWIN_WINDOW_S=55
TWIN_REPETITIONS=1
TWIN_MAX_LOOKS=8
# The noise-floor run is 39 minutes long and is analysed from the statement log afterwards.
LOG_RETENTION_MIN=50

# Load.
EVAL_RATE_SCALE=0.5
EVAL_POOL_SIZE=8
