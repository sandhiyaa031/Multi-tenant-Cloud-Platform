# Copy to .env and replace every value. .env is gitignored; never commit it.

# Control-plane database owner (runs migrations only).
CONTROL_DB_OWNER_PASSWORD=change-me
# Password of the unprivileged role the API logs in as.
CONTROL_DB_API_PASSWORD=change-me-too
# Signing key for access tokens, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Data plane (the managed PostgreSQL cluster).
DATAPLANE_OWNER_PASSWORD=change-me
DATAPLANE_REPLICATION_PASSWORD=change-me
DATAPLANE_PGBOUNCER_AUTH_PASSWORD=change-me
# Development seed only: one password shared by the four demo tenant roles.
DATAPLANE_TENANT_PASSWORD=change-me
# 1.0 = TPC-C population (3,000 customers per district); smaller loads faster.
SEED_SCALE=1.0
SEED_ITEMS=100000
