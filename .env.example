# DBPilot configuration. Copy to `.env` (or run scripts/make_env.sh, which fills the secrets with random values).
# `.env` is git-ignored and must never be committed. Everything below is a placeholder, not a credential.

# --- Secrets: one value each, at least 16 characters, different from one another ---
CONTROL_DB_OWNER_PASSWORD=
CONTROL_DB_API_PASSWORD=
CONTROL_DB_COLLECTOR_PASSWORD=
CONTROL_DB_ENGINE_PASSWORD=
DATAPLANE_OWNER_PASSWORD=
DATAPLANE_REPLICATION_PASSWORD=
DATAPLANE_PGBOUNCER_AUTH_PASSWORD=
DATAPLANE_MONITOR_PASSWORD=
DATAPLANE_EXECUTOR_PASSWORD=
DATAPLANE_TENANT_PASSWORD=
TWIN_TOKEN=
JWT_SECRET=                       # at least 32 characters

# --- The demo organization's administrator (the sign-in you use) ---
DEMO_ADMIN_EMAIL=admin@demo.dbpilot.dev
DEMO_ADMIN_PASSWORD=              # at least 10 characters

# --- Web ---
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SIGNUP_ENABLED=true

# --- Sizes: the laptop profile every recorded measurement used (16 GB machine, 24 threads) ---
SEED_SCALE=0.3
SEED_ITEMS=30000
COLLECT_INTERVAL_S=20
TWIN_DELAY_S=60
TWIN_WINDOW_S=55
TWIN_REPETITIONS=1
TWIN_MAX_LOOKS=8
EVAL_RATE_SCALE=0.5
EVAL_POOL_SIZE=8
LOG_RETENTION_MIN=15
DP_SHARED_BUFFERS=512MB
STANDBY_SHARED_BUFFERS=128MB
DP_MEM_LIMIT=1536m
REPLICA_MEM_LIMIT=768m
TWIN_MEM_LIMIT=1536m

# --- Optional: an LLM proposer. The first key found is used, in this order. Leave all empty to use the rule-based proposer only. ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
